# Model weights: fetched and hash-verified by build/fetchModels.mjs, shipped in the installer,
# never committed - 83MB that never changes does not belong in every clone's history.
models/
build/windowtolayer
build/windowtolayer-COPYING
build/ffmpeg/
# The transcode fallback's dev slot: same binary as build/ffmpeg/<os>-<arch>, staged here so
# `npm run dev:electron` runs the audio-only runtime the release ships instead of system PATH.
# `ffmpeg-8.1.2/` is the mod exporters' slot and is a full build the developer supplies.
ffmpeg-audio/
ffmpeg-8.1.2/
.windowtolayer-src/
# Local reference clone of upstream main used for pollution review; never ship.
original/
# Local upstream implementation references used during investigation; never ship.
reference/
# Optional developer override for FFmpeg; packaged builds fetch their pinned runtime.
# Local hand-made zip bundles of mods (drag-drop install test files); never ship.
mods/*.zip


# Built by packaging/windows/build-wallpaper-helper.mjs (Windows wallpaper mode helper).
build/folia-wallpaper-helper.exe
packaging/windows/wallpaper-helper/target/

# Built by packaging/windows/build-apple-music-smtc-helper.mjs (Apple Music SMTC reader).
build/folia-apple-music-smtc-helper.exe
packaging/windows/apple-music-smtc-helper/target/

# Python bytecode from the htdemucs runner, written beside it by the downloaded runtime.
__pycache__/

# Built by build/buildPythonRuntime.mjs - binary artifacts that live on the mirrors, not in git.
dist-runtime/

# --- DSH (DeepSeek Harness) run traces -------------------------------------------------------
# The harness writes per-project memory here as it works: session shards, watch state, and the
# absolute paths of whatever machine it ran on. It is agent bookkeeping, not project source, and it
# is machine-specific - a checkout must never inherit another machine's copy.
#
# `.dsh-project-memory/` was previously kept out by a LOCAL `.git/info/exclude` entry only, which
# does not travel with the repository: a fresh clone on another machine had no rule at all and would
# stage the whole directory. The rule belongs here.
.dsh-project-memory/
.dsh/
.dsh-*/
**/.dsh-project-memory/

# Agent/editor tool state that some of these tools drop into a project root.
# (`.agents/` and `.codex/` are already covered above; not repeated here.)
.agent/
.codex-*/
.codebuff-ai/
.openviking/
.cursor/
.aider*
.claude/
CLAUDE.local.md
AGENTS.local.md

# Local agent scratch and session dumps.
*.session.json
session-dump-*.json

